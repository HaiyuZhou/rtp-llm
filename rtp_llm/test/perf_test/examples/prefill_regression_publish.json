{
  "schema_version": 1,
  "model": {
    "label": "qwen2.5-7b-prefill",
    "type": "qwen_2",
    "checkpoint": "/data/models/Qwen2.5-7B-Instruct",
    "tokenizer": "/data/models/Qwen2.5-7B-Instruct",
    "topology": {
      "tp": 1,
      "dp": 1,
      "pp": 1,
      "ep": 1
    }
  },
  "engine": {
    "max_seq_len": 8193,
    "max_batch_tokens": 32768,
    "concurrency_limit": 4,
    "args": {
      "reuse_cache": 1
    },
    "env": {
      "TOKENIZERS_PARALLELISM": "false"
    }
  },
  "workload": {
    "kind": "cache_grid",
    "max_input_len": 8192,
    "cache_alignment": 64,
    "commit_tail_tokens": 64,
    "compute_steps": [
      1024,
      256
    ],
    "batch_sizes": [
      1,
      2,
      4
    ],
    "measure_runs": 3,
    "min_compute_len": 256,
    "cache_lengths": [
      0,
      2048,
      4096,
      6144
    ],
    "seed": 1
  },
  "execution": {
    "backend": "local",
    "devices": [
      0
    ]
  },
  "output": {
    "result_root": "perf_test_results"
  },
  "regression": {
    "enabled": true,
    "baseline": "baselines/qwen2.5-7b-prefill.json",
    "threshold_pct": 5.0,
    "generate_candidate": true
  },
  "publish": {
    "oss": {
      "enabled": true,
      "required": true,
      "destination": "oss://perf-results/unified-perf-test",
      "artifacts": [
        "manifest.json",
        "results/result.json",
        "results/summary.json",
        "reports/prefill_report.json",
        "reports/baseline_candidate.json"
      ]
    },
    "odps": {
      "enabled": true,
      "required": false,
      "destination": "unified_perf_test_summary",
      "artifacts": []
    }
  }
}

{
  "schema_version": 1,
  "model": {
    "label": "ssh-prefill-example",
    "type": "qwen_2",
    "checkpoint": "/models/Qwen2.5-7B-Instruct",
    "tokenizer": "/models/Qwen2.5-7B-Instruct",
    "topology": {
      "tp": 2,
      "dp": 1,
      "pp": 1,
      "ep": 1
    }
  },
  "engine": {
    "max_seq_len": 8193,
    "max_batch_tokens": 32768,
    "concurrency_limit": 4,
    "args": {
      "reuse_cache": 1
    }
  },
  "workload": {
    "kind": "cache_grid",
    "max_input_len": 8192,
    "cache_alignment": 64,
    "commit_tail_tokens": 64,
    "compute_steps": [
      1024
    ],
    "cache_lengths": [
      0,
      2048,
      4096
    ],
    "batch_sizes": [
      1,
      2
    ],
    "measure_runs": 3,
    "seed": 1
  },
  "execution": {
    "backend": "ssh",
    "hosts": [
      {
        "ssh_target": "gpu-a",
        "advertise_host": "192.0.2.11"
      },
      {
        "ssh_target": "gpu-b",
        "advertise_host": "192.0.2.12"
      }
    ],
    "gpus_per_machine": 1,
    "start_port": 12333,
    "python_bin": "/opt/conda310/bin/python",
    "source": {
      "ref": "auto",
      "build_policy": "build",
      "build_driver": "/opt/rtp-perf/build-driver/driver.py",
      "bazel_config": "cuda13"
    }
  },
  "output": {
    "result_root": "perf_test_results"
  },
  "regression": {},
  "publish": {}
}
